              "inference_concurrency": 2,
              "max_subagents": 4,
              "memory_high_bytes": 1073741824,
              "memory_max_bytes": 2147483648,
              "tasks_max": 128,
              "timeout_seconds": 300
            },
            "capabilities": [],
            "guard": null,
            "isolation": "required",
            "message_peers": [],
            "network": "deny",
            "parent_id": null,
            "project": "default",
            "require_cgroup": true,
            "task": null
