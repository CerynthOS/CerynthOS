    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "diff",
        "test_result",
        "task_result"
      ]
    },
    "GuardCapability": {
      "type": "object",
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "mode": {
          "default": "allow",
          "allOf": [
            {
              "$ref": "#/definitions/GuardCapabilityMode"
            }
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GuardCapabilityMode": {
      "type": "string",
      "enum": [
        "allow",
        "approval",
        "deny"
      ]
    },
    "GuardPolicy": {
      "type": "object",
      "properties": {
        "capabilities": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/GuardCapability"
          }
        }
      },
      "additionalProperties": false
    },
    "HarnessKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "generic_pty",
            "open_code",
            "hermes",
            "codex",
            "claude_code",
            "acp"
          ]
        },
        {
          "description": "Endpoint smoke test, with no tools or agent process.",
          "type": "string",
          "enum": [
            "inference_probe"
          ]
        }
      ]
    },
    "IsolationPolicy": {
      "type": "string",
      "enum": [
        "required",
        "unisolated"
      ]
    },
    "LaunchRequest": {
      "type": "object",
      "required": [
        "program"
      ],
      "properties": {
        "args": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initial_input": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "program": {
          "type": "string"
        },
        "pty": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
