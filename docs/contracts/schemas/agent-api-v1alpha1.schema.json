    "ModelConfig": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "cloud_consent": {
          "default": false,
          "type": "boolean"
        },
        "disable_thinking": {
          "default": false,
          "type": "boolean"
        },
        "endpoint_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "default": "local",
