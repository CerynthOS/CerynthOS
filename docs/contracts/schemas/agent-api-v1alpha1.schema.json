{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "required": [
    "operation",
    "version"
  ],
  "properties": {
    "operation": {
      "$ref": "#/definitions/Operation"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
