      },
      "additionalProperties": false
    },
    "ModelMode": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    },
    "NetworkPolicy": {
      "type": "string",
      "enum": [
        "deny",
        "host"
      ]
