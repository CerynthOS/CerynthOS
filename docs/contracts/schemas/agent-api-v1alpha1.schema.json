    "ResourceBudget": {
      "type": "object",
      "properties": {
        "cpu_weight": {
          "default": 100,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "gpu_memory_bytes": {
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "inference_concurrency": {
          "default": 2,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_subagents": {
          "default": 4,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "memory_high_bytes": {
          "default": 1073741824,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "memory_max_bytes": {
          "default": 2147483648,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tasks_max": {
          "default": 128,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "timeout_seconds": {
          "default": 300,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
