[Unit]
Description=CerynthOS successful boot marker
Documentation=https://github.com/CerynthOS/CerynthOS
After=multi-user.target
ConditionPathIsReadWrite=/run

[Service]
Type=oneshot
RemainAfterExit=yes

# All logic lives in the script: systemd treats '%' as a specifier, so a
# printf format string written inline here corrupts itself silently.
ExecStart=/usr/lib/cerynth/cerynth-boot-marker

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
